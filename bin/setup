#!/usr/bin/env bash
# bin/setup

source "$(dirname "$0")/_lib.sh"

if [[ ! -x "$MISE_BIN" ]]; then
  echo "mise was not found at $MISE_BIN; set MISE_BIN to its executable path." >&2
  exit 127
fi

PATH="$(dirname "$MISE_BIN"):$PATH" "$MISE_BIN" install
PATH="$(dirname "$MISE_BIN"):$PATH" "$MISE_BIN" exec -- bundle install
