#!/usr/bin/env bash
# bin/doctor

source "$(dirname "$0")/_lib.sh"

if [[ -x "$MISE_BIN" ]]; then
  echo "mise: $($MISE_BIN --version)"
  PATH="$(dirname "$MISE_BIN"):$PATH" "$MISE_BIN" exec -- ruby --version
  PATH="$(dirname "$MISE_BIN"):$PATH" "$MISE_BIN" exec -- bundle check
else
  echo "mise: unavailable; using the active Ruby toolchain"
  ruby --version
  bundle check
fi
